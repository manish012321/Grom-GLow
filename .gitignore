# ==========================================
# Groom & Glow - Unified Git Ignore
# ==========================================

# 1. Dependencies (both Root Next.js & Backend)
node_modules/
backend/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Next.js Builds & Cache
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# 3. Environment Variables
# Ignore actual env secrets but keep sample templates committed
.env*.local
.env
backend/.env
!.env*.example
!backend/.env.example

# 4. Backend Database & State
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
*.sqlite
*.sqlite3

# 5. Testing & Coverage
/coverage
backend/coverage

# 6. Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 7. Vercel & Cloud Deployments
.vercel

# 8. OS & Editor Artifacts
.DS_Store
Thumbs.db
*.pem

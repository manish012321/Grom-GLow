{
  "name": "groom-and-glow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "node ./node_modules/next/dist/bin/next dev",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "node ./node_modules/concurrently/dist/bin/index.js -n \"frontend,backend\" -c \"cyan.bold,magenta.bold\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js",
    "seed": "npm run seed --prefix backend"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4"
  }
}
